rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Fotos y audios de las alertas. La ESP32-CAM sube con el idToken de un usuario
    // normal de Firebase Auth (email/password en secrets.h), así que la escritura
    // tiene que permitirse a usuarios autenticados (con `write: if false` da 403).
    match /alerts/{deviceId}/{file=**} {
      allow read, write: if request.auth != null;
    }
  }
}
