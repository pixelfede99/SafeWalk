//
//  secrets.h lo usan AMBAS placas (DevKit y ESP32-CAM).
// ============================================================================
#pragma once

// ---------------------- WiFi ----------------------
#define WIFI_SSID          "TU_RED_WIFI"          // <-- AJUSTAR
#define WIFI_PASSWORD      "TU_PASSWORD_WIFI"     // <-- AJUSTAR

// ---------------------- Firebase ----------------------
// Web API Key:   Firebase console -> Project Settings -> General -> Web API Key
#define FB_API_KEY         "TU_FIREBASE_WEB_API_KEY"        // <-- AJUSTAR
// Project ID:    el id del proyecto (ej. safewalk-capstone)
#define FB_PROJECT_ID      "TU_FIREBASE_PROJECT_ID"         // <-- AJUSTAR
// Storage bucket: termina en .appspot.com (Project Settings -> Storage bucket)
#define FB_STORAGE_BUCKET  "TU_PROYECTO.appspot.com"        // <-- AJUSTAR

// Usuario "de servicio" para el bastón (crealo en Authentication -> Users,
// con Email/Password habilitado). El ESP32 se loguea con esto para poder
// ESCRIBIR en Firestore/Storage (las reglas exigen usuario autenticado).
#define FB_DEVICE_EMAIL    "bastontron@safewalk.local"      // <-- AJUSTAR
#define FB_DEVICE_PASSWORD "UNA_PASSWORD_FUERTE"            // <-- AJUSTAR
