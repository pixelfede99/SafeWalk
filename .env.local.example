# ============================================================
# Firebase Web SDK - se obtienen desde la consola de Firebase
# Project Settings -> General -> Your apps -> Web app
# ============================================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Opcional: solo si vas a usar notificaciones push (FCM)
# Project Settings -> Cloud Messaging -> Web Push certificates
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Solo SERVIDOR (ruta /api/notify): cuenta de servicio para mandar las push con la
# app cerrada. Firebase Console -> Configuración del proyecto -> Cuentas de servicio
# -> Generar nueva clave privada. Pegá el JSON COMPLETO en una sola línea.
# En Vercel: Settings -> Environment Variables (tildá Production y Preview) y
# después Redeploy. Verificar: GET /api/notify tiene que decir {"configured":true}.
# NUNCA lo subas a git: es una llave del proyecto.
FIREBASE_SERVICE_ACCOUNT=
