rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // REGLAS DE DESARROLLO / DEMO
    // ------------------------------------------------------------
    // Cualquier usuario autenticado puede leer/escribir.
    // Es lo más simple para que funcione el modo demo desde el navegador.
    // Cuando integres el ESP32 real y la app vaya a producción,
    // reemplazá estas reglas por las "ESTRICTAS" que están más abajo
    // (comentadas) y vinculá al ESP32 con cuenta de servicio.
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /devices/{deviceId} {
      allow read, write: if isSignedIn();
    }

    match /locations/{deviceId}/history/{point} {
      allow read, write: if isSignedIn();
    }

    match /alerts/{alertId} {
      allow read, write: if isSignedIn();
    }

    // Órdenes de la app al bastón (ej. "hacé sonar el buzzer").
    // Colección aparte de devices/ porque ese doc lo reescribe el heartbeat.
    match /commands/{deviceId} {
      allow read, write: if isSignedIn();
    }

    // ============================================================
    // REGLAS ESTRICTAS DE PRODUCCIÓN (para usar más adelante)
    // ------------------------------------------------------------
    // function isSelf(uid) { return isSignedIn() && request.auth.uid == uid; }
    //
    // match /users/{userId} { allow read, write: if isSelf(userId); }
    //
    // match /devices/{deviceId} {
    //   allow read: if isSignedIn() && (
    //     resource.data.ownerUid == request.auth.uid ||
    //     request.auth.uid in resource.data.caregiverUids
    //   );
    //   allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
    //   allow update, delete: if false; // solo el ESP32
    // }
    //
    // match /locations/{deviceId}/history/{point} {
    //   allow read: if isSignedIn() && exists(/databases/$(database)/documents/devices/$(deviceId))
    //     && (
    //       get(/databases/$(database)/documents/devices/$(deviceId)).data.ownerUid == request.auth.uid ||
    //       request.auth.uid in get(/databases/$(database)/documents/devices/$(deviceId)).data.caregiverUids
    //     );
    //   allow write: if false; // solo el ESP32
    // }
    //
    // match /alerts/{alertId} {
    //   allow read: if isSignedIn();
    //   allow update: if isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen','seenBy']);
    //   allow create, delete: if false; // solo el ESP32
    // }
    //
    // match /commands/{deviceId} {
    //   allow read: if isSignedIn();   // el bastón lee su propia orden
    //   // Solo el dueño o un familiar del círculo puede hacer sonar el bastón,
    //   // y solo puede tocar los campos de la orden (no inventar otros).
    //   allow write: if isSignedIn()
    //     && exists(/databases/$(database)/documents/devices/$(deviceId))
    //     && (
    //       get(/databases/$(database)/documents/devices/$(deviceId)).data.ownerUid == request.auth.uid ||
    //       request.auth.uid in get(/databases/$(database)/documents/devices/$(deviceId)).data.caregiverUids
    //     )
    //     && request.resource.data.keys().hasOnly(['deviceId','ringToken','ringSeconds','requestedBy','updatedAt','ackToken']);
    // }
  }
}
